	"type": "module",
	"description": "Nowledge Mem plugin for Alma, local-first personal knowledge base",
	"author": {
		"name": "Nowledge Labs",
		"email": "hello@nowledge-labs.ai",
		"url": "https://nowledge-labs.ai"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/nowledge-co/community.git",
		"directory": "nowledge-mem-alma-plugin"
	},
	"main": "main.js",
	"scripts": {
		"test": "node --test --test-timeout=10000 tests/*.test.mjs",

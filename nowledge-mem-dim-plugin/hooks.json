{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$DIM_PLUGIN_ROOT/scripts/run-hook.sh\" context",
            "commandWindows": "cmd /d /s /v:off /c \"\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%DIM_PLUGIN_ROOT%\\scripts\\run-hook.ps1\" context\"",
            "timeout": 12
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$DIM_PLUGIN_ROOT/scripts/run-hook.sh\" prompt",
            "commandWindows": "cmd /d /s /v:off /c \"\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%DIM_PLUGIN_ROOT%\\scripts\\run-hook.ps1\" prompt\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$DIM_PLUGIN_ROOT/scripts/run-hook.sh\" capture",
            "commandWindows": "cmd /d /s /v:off /c \"\"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%DIM_PLUGIN_ROOT%\\scripts\\run-hook.ps1\" capture\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
